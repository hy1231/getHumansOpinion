# 环境变量配置文件示例
# 将此文件重命名为 .env 并填写您的配置

# 代理服务器配置（访问 Twitter 需要）
PROXY=http://your-proxy-server:port

# Twitter/X 认证信息（从浏览器开发者工具获取）
TWITTER_AUTH_TOKEN=your-auth-token-here
TWITTER_CT0=your-ct0-token-here

# Google Gemini API Key（用于翻译和 AI 解读）
GOOGLE_API_KEY=your-google-api-key-here

# 企业微信群机器人 Webhook URL（可选，用于推送报告）
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-webhook-key

# 抓取配置（可选）
CHECK_INTERVAL_MINUTES=30
MAX_ITEMS_PER_CHECK=30

# 要监控的人物列表（可选，不配置则监控所有人物）
# 支持: elon_musk, donald_trump
# 多个用逗号分隔，如：MONITOR_PERSONALITIES=elon_musk,donald_trump
MONITOR_PERSONALITIES=